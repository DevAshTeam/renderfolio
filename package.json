{
  "name": "renderfolio",
  "version": "1.0.0",
  "description": "Render a beautiful portfolio from Markdown to HTML + PDF",
  "type": "module",
  "bin": {
    "renderfolio": "./bin/renderfolio.js"
  },
  "scripts": {
    "start": "node bin/renderfolio.js",
    "web": "node web/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "keywords": [
    "portfolio",
    "markdown",
    "html",
    "pdf",
    "renderfolio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DevAshTeam/renderfolio.git"
  },
  "homepage": "https://github.com/DevAshTeam/renderfolio#readme",
  "author": "DevAshTeam",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@cloudflare/puppeteer":"^1.4.0",
    "@hono/node-server":"^2.1.3",
    "hono":"^4.13.13",
    "chalk":"^6.0.1",
    "commander":"^15.0.0",
    "fs-extra":"^11.4.1",
    "gray-matter":"^4.0.3",
    "markdown-it":"^15.0.2",
    "playwright":"^1.63.0",
    "js-yaml":"^5.4.3"
  },
  "devDependencies": {
    "jest":"^30.5.2",
    "wrangler":"^4.148.0"
  }
}
